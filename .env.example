# Server-side only. Create a Hugging Face token with inference permission.
HF_TOKEN=
# Optional: choose a chat-completion model available through your HF provider.
HF_MODEL=Qwen/Qwen2.5-7B-Instruct-1M
# Public canonical origin, used by metadata, sitemap.xml, robots.txt, and JSON-LD.
SITE_URL=https://atsforge.org
# An actively monitored mailbox shown on the Contact and legal pages.
SUPPORT_EMAIL=support@atsforge.org
# Set these to the real person or registered business operating ATSForge before launch.
LEGAL_ENTITY_NAME=ATSForge
LEGAL_ADDRESS=
# Optional Google Search Console verification token (not the complete meta tag).
GOOGLE_SITE_VERIFICATION=
